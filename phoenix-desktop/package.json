{
  "name": "phoenix-desktop",
  "version": "1.1.0",
  "description": "Phoenix, the free neuro-affirming AI assistant, floating on your desktop. A see-through window over the live site.",
  "main": "main.js",
  "author": "NeuroHub Community",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js && node test/speech.js",
    "dist": "electron-builder --win dir --x64 --arm64",
    "test:speech": "node test/speech.js",
    "setup": "node scripts/setup.js"
  },
  "build": {
    "appId": "org.neurohubcommunity.phoenix.desktop",
    "productName": "Phoenix Desktop",
    "files": [
      "main.js",
      "preload.js",
      "speech.js",
      "speech-preload.js",
      "offline.html",
      "icon.png",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "speech/**"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Phoenix-Desktop-${arch}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "speech/**"
    ]
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "vosk-browser": "^0.0.8"
  }
}
